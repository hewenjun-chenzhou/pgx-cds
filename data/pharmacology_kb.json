  "inference_chains": {
    "description": "典型多跳推理链 - 从血液标记物异常到用药建议的完整路径",
    "chains": [
      {
        "chain_id": "CCA-LIVER-ALT-DRUG",
        "description": "肝功能异常 + CYP底物 → 剂量调整",
        "steps": [
          {"node": "血液标记物", "type": "input", "field": "ALT", "condition": ">3xULN"},
          {"node": "CYP代谢能力", "type": "rule", "rule": "CCA-D6-LIVER-ALT-3X / CCA-C19-LIVER-ALT-3X", "effect": "代谢↓50%"},
          {"node": "药物蓄积风险", "type": "inference", "logic": "代谢↓50% + 原剂量 → 暴露量↑"},
          {"node": "用药建议", "type": "output", "action": "减半剂量并密切监测"}
        ]
      },
      {
        "chain_id": "CCA-RENAL-CRCL-DRUG",
        "description": "肾功能不全 + CYP底物 → 蓄积风险 + 剂量调整",
        "steps": [
          {"node": "血液标记物", "type": "input", "field": "CrCl", "condition": "<30mL/min"},
          {"node": "CYP代谢能力", "type": "rule", "rule": "CCA-D6-RENAL-CRCL-30 / CCA-C19-RENAL-CRCL-30", "effect": "底物蓄积风险↑"},
          {"node": "排泄减少", "type": "inference", "logic": "CrCl<30 → 肾脏排泄↓ + 代谢↓ → 双重蓄积"},
          {"node": "用药建议", "type": "output", "action": "减量或换用非CYP底物"}
        ]
      },
      {
        "chain_id": "CCA-COAG-INR-ANTICOAG",
        "description": "凝血功能异常 + 抗凝药 → 出血风险叠加",
        "steps": [
          {"node": "血液标记物", "type": "input", "field": "INR", "condition": ">1.5"},
          {"node": "肝脏合成功能", "type": "rule", "rule": "INR升高=肝脏合成功能下降", "effect": "CYP代谢↓"},
          {"node": "出血风险", "type": "inference", "logic": "INR↑ + CYP底物抗凝药 → 出血风险叠加"},
          {"node": "用药建议", "type": "output", "action": "密切监测出血体征，必要时减量"}
        ]
      }
    ]
